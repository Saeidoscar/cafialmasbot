# ─────────────────────────────────────────────
# .env.example — نمونه متغیرهای محیطی
# فایل .env را بسازید و مقادیر واقعی را وارد کنید
# هرگز این فایل را با اطلاعات واقعی.commit نکنید
# ─────────────────────────────────────────────

# توکن ربات تلگرام (از @BotFather دریافت کنید)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# آدرس کامل سرویس در Render (بدون / انتهایی)
APP_URL=https://your-service.onrender.com

# مسیر پایگاه داده SQLite
DB_PATH=./data/cafe.db

# تنظیمات ArvanCloud AI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_BASE_URL=https://your-ai-gateway.example.com/v1
OPENAI_MODEL=gpt-4o-mini

# کلید API برای عامل محلی Playwright (از `openssl rand -hex 32` تولید کنید)
AGENT_API_KEY=YOUR_RANDOM_AGENT_API_KEY_HERE

# کلید API برای داشبورد مدیریتی (اختیاری — اگر تنظیم نشود، AGENT_API_KEY استفاده می‌شود)
DASHBOARD_API_KEY=YOUR_RANDOM_DASHBOARD_API_KEY_HERE
